# Mock provider (default). Leave LLM_API_KEY unset.
# LLM_PROVIDER=mock

# OpenAI-compatible provider. OpenRouter example:
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4.1-flash

# DATA_DIR=.data/pglite

# Production and Vercel require the pooled Neon connection string.
# Local development and CI use embedded PGlite when this is unset.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Approximate model context window used for conversation compaction. Default 8192.
# LLM_CONTEXT_TOKENS=8192

# Web search and page fetch. Without this key those tools return mock results.
# TAVILY_API_KEY=

# Read GitHub issues, pull requests, and files. Without this token the tool returns mock data.
# GITHUB_TOKEN=

# Calendar OAuth is not wired up yet. Leave this unset to use mock events.
# A bearer token calls the Calendar API directly and is optional, not the OAuth flow.
# GOOGLE_CALENDAR_ACCESS_TOKEN=

# A connector stores the name of an environment variable, not the secret itself.
# The name must start with MCP_. Other names, such as LLM_API_KEY, are rejected.
# The mock MCP server reads MCP_DEMO_TOKEN when a connector references it.
# MCP_DEMO_TOKEN=

# Sandbox. Leave DAYTONA_API_KEY unset to use the in-process mock computer.
# DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_TARGET=us
# SANDBOX_COMMAND_TIMEOUT_MS=10000
# SANDBOX_DATA_DIR=.data/sandbox

# Routines worker. `npm run dev` starts it in-process. `npm run routines` is the
# long-lived process. Do not run both against the same embedded Postgres.
# ROUTINES_WORKER=inline
# ROUTINE_POLL_MS=1000
# ROUTINE_WORKER_ID=

# Public origin used to build OAuth redirect URIs. Set this in production so the
# redirect matches the URI registered with each provider. Locally it can be omitted
# and the request origin is used.
# APP_ORIGIN=http://localhost:3000
# APP_ORIGIN=https://mockbot-jet.vercel.app

# Catalog OAuth. Do not commit the values. A provider whose variables are unset
# refuses to connect.
#
# Redirect URI to register (path is always /connectors/oauth/callback):
#   http://localhost:3000/connectors/oauth/callback
#   https://mockbot-jet.vercel.app/connectors/oauth/callback
#
# Notion public integration (https://www.notion.so/profile/integrations):
# One integration can list both redirect URIs. Notion does not use PKCE.
# Token exchange is HTTP Basic. Enable read content, update content, and insert content.
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
#
# GitHub OAuth App (https://github.com/settings/developers):
# Each OAuth App has one authorization callback URL, so use a separate app per environment.
# PKCE S256 is sent. Requested scopes: repo, read:org, read:user.
# Turn on "Expire user authorization tokens" to receive refresh tokens.
# The access token is sent to https://api.githubcopilot.com/mcp/
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
